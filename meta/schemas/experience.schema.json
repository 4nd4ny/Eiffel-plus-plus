{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expérience située Eiffel++ 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "problem",
    "context",
    "reference_run",
    "runs",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "problem": {
      "type": "object",
      "required": [
        "observation",
        "hypothesis",
        "expected_change",
        "evidence"
      ],
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "expected_change": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "applies_when",
        "avoid_when"
      ],
      "properties": {
        "applies_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "avoid_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "reference_run": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "outcome",
          "evidence",
          "costs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "UNKNOWN",
              "STALE"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "costs": {
            "type": "object",
            "required": [
              "seconds",
              "tokens",
              "usd"
            ],
            "properties": {
              "seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "outcome",
        "selected_run",
        "reason",
        "limitations"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "KEEP_BASE",
            "ADOPT",
            "INCONCLUSIVE"
          ]
        },
        "selected_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  },
  "description": "Le contrôleur vérifie aussi unicité, références locales et cohérence de décision. Aucune authenticité ou efficacité établie."
}
