{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paquet N1 facultatif de méta-harnais Eiffel++ 0.5.0",
  "description": "Les fichiers référencés doivent exister dans le paquet, sans lien symbolique. L'entrypoint appartient à prompts. Ces conditions et le profil sont contrôlés par tools/meta_harness.py ; le sens des prompts et l'autorité restent à qualifier.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "level",
    "status",
    "profile",
    "entrypoint",
    "prompts",
    "output_contract",
    "source_pattern"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.2.0",
        "0.3.0",
        "0.4.0",
        "0.5.0"
      ]
    },
    "kind": {
      "const": "meta-harness"
    },
    "level": {
      "const": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "decision_ref": {
      "$ref": "#/$defs/text"
    },
    "profile": {
      "$ref": "#/$defs/path"
    },
    "entrypoint": {
      "$ref": "#/$defs/path"
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "output_contract": {
      "$ref": "#/$defs/path"
    },
    "source_pattern": {
      "$ref": "#/$defs/text"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "required": [
          "decision_ref"
        ]
      }
    },
    {
      "$ref": "skills.schema.json"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s]*$)[^\u0000]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git|_eiffel)(?:/|$))(?!.*[\\\\:\u0000-\u001f])[^/]+(?:/[^/]+)*$"
    }
  }
}
